# Copy to .env.local via `pnpm setup` or manually.
# Do not commit real secrets.

# Public site URL (used in metadata / absolute links later)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional proxy (mainly 链动 ShopApi). Leave unset to run direct. ---
# Extract-IP API (worker uses up to 4 channels; max 2 extracts / 10 minutes):
# PROXY_API_URL=
# Fixed single proxy:
# PROXY_URL=http://user:pass@host:port
# Compat alias for PROXY_URL:
# COLLECTOR_HTTP_PROXY=

# Optional: collector concurrency / delays (milliseconds)
# COLLECTOR_PAGE_DELAY_MS=3000
# COLLECTOR_MAX_CONCURRENCY=1
# COLLECTOR_LIANDONG_HOST_GAP_MS=1500
# COLLECTOR_LIANDONG_SHOP_DELAY_MS=4000

# Worker loop (defaults are fine for open-source self-host)
# WORKER_TICK_MS=600000
# WORKER_CLAIM_LIMIT=64

# Process memory TTL for explorer catalog snapshot (seconds, clamped 30-300, default 60)
# CATALOG_CACHE_TTL_SECONDS=60

# Official regional prices (SQLite). Default: data/official-prices.sqlite
# OFFICIAL_DB_PATH=
# Process TTL for official plan summaries (seconds, clamped 30-900, default 300)
# OFFICIAL_CACHE_TTL_SECONDS=300

# API transit storage (SQLite is write-side; frontend reads the JSON snapshot)
# TRANSIT_DB_PATH=data/transit.sqlite
# TRANSIT_SNAPSHOT_PATH=data/transit/latest.json
# Process TTL for API transit snapshot (seconds, clamped 60-3600, default 300)
# TRANSIT_CACHE_TTL_SECONDS=300
# Uniform transit pricing interval: 6 (default), 12 or 24 hours. Failures retry earlier.
# TRANSIT_COLLECT_INTERVAL_HOURS=6

# After collect: prewarm Next (revalidate + warm public reads). Separate from collector process.
# PREWARM_BASE_URL=http://localhost:3000
# COLLECTOR_REVALIDATE_SECRET=
